# Local single-user demo. Do not expose this instance to the internet.
STUDIO_STORAGE=local
STUDIO_DATA_DIR=./data
# Optional: server-side image provider; both values required.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_TEXT_MODEL=gpt-4.1-mini
AI_REVIEW_HOURLY_LIMIT=20
# Maximum real image generations per hour in this local process
IMAGE_HOURLY_LIMIT=10

# Cloud: set STUDIO_STORAGE=supabase and fill ALL fields below on the host.
# Keep these server-side: do not add NEXT_PUBLIC_ prefixes to secrets.
SUPABASE_URL=https://sqtsnecaxcvwgqkljyca.supabase.co
SUPABASE_PUBLISHABLE_KEY=
STUDIO_APP_URL=
# Comma-separated administrator/account emails. Empty denies all users.
STUDIO_ALLOWED_EMAILS=emarianelimafcm@gmail.com
# Exactly 32 random bytes as 64 hexadecimal characters. Keep in a secret manager.
STUDIO_ENCRYPTION_KEY=
# Optional: JSON exported from Compliance, reviewed before public use.
STUDIO_PUBLIC_LEGAL_JSON=
